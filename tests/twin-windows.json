  "units": {
    "x": "1e-4 percentage points (32500 = 3.25%)",
    "D": "1e-4 percentage points",
    "A": "1e-4 pp-months",
    "scores": "millionths",
    "pp_exact": "exact YoY in percentage points as a reduced fraction, unrounded"
  },
  "method": {
    "x": "x_t = floor(10^6 * (P_t - P_{t-12}) / P_{t-12}) from make_vectors.yoy; a window is x_0..x_47 and needs levels P_{-12}..P_47 (60 months)",
    "endpoints": "x_start = x_0 (first month of the window), x_end = x_47 (last month)",
    "distance": "Chebyshev = max(|x_start - x_start_ref|, |x_end - x_end_ref|) on the contract's floored x; L1 = |dx_start| + |dx_end|; l2_squared = dx_start^2 + dx_end^2 (rank-equivalent to L2)",
    "primary_metric": "chebyshev",
    "reference": "2021-01..2024-12 (on-chain session A)",
    "candidate_set": "every 48-month window with all 60 levels present, excluding windows whose 48 observation months overlap the reference's: |start - 2021-01| < 48 months, i.e. starts 2017-02..2024-12 (the reference itself is among them)",
    "tie_rule": "ordinal rank sorts by (distance, start month), so ties go to the earlier start; competition rank is 1 + the number of strictly closer candidates (ties share it)",
    "dedup_rule": "greedy over the (distance, start month) order: keep a window unless its observation months overlap an already kept one (|start - kept start| < 48); the de-duplicated rank is the position among kept windows",
    "scores": "score_cooling = floor(10^6 * min(D, Dcap) / Dcap); score_excess = floor(10^6 * min(A, Acap) / Acap), K = 40000",
    "wording_threshold": "'within 0.15 pp' is tested as |gap| <= 0.15 pp on both endpoints (the strict < variant is recorded too); contract values use the floored x, exact values use fractions.Fraction"
  },
  "level_precision": {
    "first_month_with_more_than_one_significant_decimal": "2007-01",
    "all_earlier_levels_have_at_most_one_significant_decimal": true,
    "note": "FRED stores every level with three decimals; before that month the last two are always 0"
  },
