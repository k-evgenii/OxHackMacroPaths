# Server only. Devnet RPC with a key (Helius / QuickNode); the public endpoint rate-limits getTransaction.
RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet
# Reference session A, settled and read-only.
NEXT_PUBLIC_DEFAULT_SESSION=B89zLLRMtmwAKP5idiUt6ffzfetNo6xRZBbXpDVaBVju
# 1 = pages read packages/client/fixtures instead of /api (no RPC needed).
NEXT_PUBLIC_USE_FIXTURES=0
# Optional, server only: list just these sessions on the home page, in this order (comma-separated).
# Unset = every Session account the program owns.
#SESSION_ALLOWLIST=B89zLLRMtmwAKP5idiUt6ffzfetNo6xRZBbXpDVaBVju
