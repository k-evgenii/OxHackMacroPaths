# Copy to .env and fill in. .env is gitignored: NEVER commit it.
#
# RPC_URL: a Solana DEVNET RPC endpoint from Helius or QuickNode, e.g.
#   https://devnet.helius-rpc.com/?api-key=<YOUR_KEY>
#   or a QuickNode devnet URL (https://<name>.solana-devnet.quiknode.pro/<token>/)
# The URL embeds your API key, so it must never be committed. Devnet only, not mainnet.
RPC_URL=

# KEEPER_KEYPAIR: path to the keeper's Solana keypair JSON file,
# e.g. ~/.config/solana/keeper-devnet.json. Keep it outside the repo; never commit it.
KEEPER_KEYPAIR=
