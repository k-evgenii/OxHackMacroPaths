# Copy to .env and fill in. .env is gitignored: NEVER commit it.
#
# RPC_URL: a Solana DEVNET RPC endpoint from Helius or QuickNode, e.g.
#   https://devnet.helius-rpc.com/?api-key=<YOUR_KEY>
#   or a QuickNode devnet URL (https://<name>.solana-devnet.quiknode.pro/<token>/)
# The URL embeds your API key, so it must never be committed. Devnet only, not mainnet.
RPC_URL=

# KEEPER_KEYPAIR: path to the keeper's Solana keypair JSON file,
# e.g. ~/.config/solana/keeper-devnet.json. Keep it outside the repo; never commit it.
KEEPER_KEYPAIR=

# The public devnet RPC (https://api.devnet.solana.com) rate-limits; a keyed
# Helius/QuickNode devnet endpoint is recommended for RPC_URL.
#
# Devnet reference values (docs/deployments.md). The keeper does NOT read these;
# they are listed here for convenience only, not as env vars.
# reference: PROGRAM_ID=FvT786RtMTtbdXWemA9zgA9rfwhvxFsKY1ypiMMNwMbS
# reference: SESSION=B89zLLRMtmwAKP5idiUt6ffzfetNo6xRZBbXpDVaBVju  (reference session A, settled)
