{
  "name": "@macropaths/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MacroPaths off-chain keeper: prepares data and posts observations to the Solana program.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "tsx": "tsx",
    "env:check": "tsx scripts/env-check.ts",
    "smoke:transfer": "tsx scripts/smoke-transfer.ts",
